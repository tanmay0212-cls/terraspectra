# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so
*.dll

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Large Datasets and Cache (retain folder structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/benchmarks/*
!data/benchmarks/.gitkeep

# Model weights and artifacts (ignore heavy checkpoints)
models/checkpoints/*
!models/checkpoints/.gitkeep
models/onnx/*
!models/onnx/.gitkeep
*.pt
*.pth
*.h5
*.ckpt

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log
logs/

# Frontend (Node / Vite)
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Operating System specific
.DS_Store
Thumbs.db
desktop.ini
